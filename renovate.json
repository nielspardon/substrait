{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(build)",
    "customManagers:githubActionsVersions",
    ":maintainLockFilesWeekly"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group pyproject.toml dependency bumps so pixi.lock is regenerated once",
      "matchManagers": ["pep621", "pixi"],
      "groupName": "all pixi deps"
    },
    {
      "description": "Bumping the supported Python range is a project decision, not a routine bump",
      "matchDepTypes": ["requires-python"],
      "enabled": false
    }
  ]
}
